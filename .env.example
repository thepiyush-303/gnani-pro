# Copy to .env and fill in. Expo inlines EXPO_PUBLIC_* at bundle time — restart Metro
# (`npx expo start --clear`) after changes. NOTE: EXPO_PUBLIC_* values are embedded in the app bundle.

# Gnani speech key (Prisma STT, https://api.vachana.ai/stt/v3)
EXPO_PUBLIC_GNANI_API_KEY=

# ── LLM provider switch: gemini | evon ──
EXPO_PUBLIC_LLM_PROVIDER=gemini

# Gemini API (https://aistudio.google.com/apikey). Free-tier model by default.
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_MODEL=gemini-3.5-flash-lite

# Evon / any OpenAI-compatible POST /chat/completions endpoint.
# If EVON_ENDPOINT is empty, legacy guessed Gnani URLs are tried (currently all fail: 403 / 404 / DNS).
EXPO_PUBLIC_EVON_ENDPOINT=
EXPO_PUBLIC_EVON_MODEL=evon-3.3
# Falls back to EXPO_PUBLIC_GNANI_API_KEY when empty.
EXPO_PUBLIC_EVON_API_KEY=
