<?xml version="1.0" encoding="utf-8"?>
<!-- overlay_drop_zone.xml - Bottom-center Drop Zone for Drag-to-Disable -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drop_zone_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:clickable="false"
    android:focusable="false">

    <FrameLayout
        android:id="@+id/drop_zone_circle"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/drop_zone_bg_idle"
        android:elevation="14dp">

        <TextView
            android:id="@+id/drop_zone_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="✕"
            android:textColor="#FAFAFA"
            android:textSize="22sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/drop_zone_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Drop to disable"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>

