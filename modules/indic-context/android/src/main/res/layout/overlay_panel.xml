<?xml version="1.0" encoding="utf-8"?>
<!--
  overlay_panel.xml — Phase 1 native overlay toolbar layout.

  This is inflated by OverlayService and rendered above the stock keyboard
  via WindowManager TYPE_APPLICATION_OVERLAY.

  Phase 1: Native Android views only (ImageButton toolbar + drag handle).
  Phase 2+: This container will host a ReactRootView rendering the full
             React Native OverlayPanel component.

  Design:
  ┌───────────────────────────────────────────────────────┐
  │ ▒▒▒▒ (drag handle)                                 │
  │  [🎤 Mic]  [🎨 Tone]  [❄️ Icebreaker]  [⋯ More]    │
  └───────────────────────────────────────────────────────┘
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp">

    <!-- Card container with background -->
    <LinearLayout
        android:id="@+id/card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/overlay_bg"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- Header row: Drag handle & Close button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp">

            <!-- Drag handle in center -->
            <View
                android:id="@+id/drag_handle"
                android:layout_width="48dp"
                android:layout_height="5dp"
                android:layout_centerInParent="true"
                android:background="#4DFFFFFF"
                android:clickable="true"
                android:focusable="true" />

            <!-- Close button on right -->
            <ImageButton
                android:id="@+id/btn_close"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="Close overlay"
                android:padding="4dp"
                android:scaleType="fitCenter" />
        </RelativeLayout>

        <!-- Actions row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp">

            <!-- Mic button -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageButton
                    android:id="@+id/btn_mic"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="#1AFFFFFF"
                    android:src="@android:drawable/ic_btn_speak_now"
                    android:padding="10dp"
                    android:contentDescription="Voice to Text"
                    android:scaleType="fitCenter" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Voice"
                    android:textColor="#B3FFFFFF"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Tone button -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageButton
                    android:id="@+id/btn_tone"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="#1AFFFFFF"
                    android:src="@android:drawable/ic_menu_edit"
                    android:padding="10dp"
                    android:contentDescription="Tone and Rewrite"
                    android:scaleType="fitCenter" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tone"
                    android:textColor="#B3FFFFFF"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Icebreaker button -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageButton
                    android:id="@+id/btn_icebreaker"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="#1AFFFFFF"
                    android:src="@android:drawable/star_on"
                    android:padding="10dp"
                    android:contentDescription="Icebreaker Suggestions"
                    android:scaleType="fitCenter" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Icebreaker"
                    android:textColor="#B3FFFFFF"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
