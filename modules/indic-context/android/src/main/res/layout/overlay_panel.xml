<?xml version="1.0" encoding="utf-8"?>
<!--
  overlay_panel.xml — Phase 1 native overlay toolbar layout.

  This is inflated by OverlayService and rendered above the stock keyboard
  via WindowManager TYPE_APPLICATION_OVERLAY.

  Phase 1: Native Android views only (ImageButton toolbar + drag handle).
  Phase 2+: This container will host a ReactRootView rendering the full
             React Native OverlayPanel component.

  Design:
  ┌───────────────────────────────────────────────────────┐
  │ ▒▒▒▒ (drag handle)                                 │
  │  [🎤 Mic]  [🎨 Tone]  [❄️ Icebreaker]  [⋯ More]    │
  └───────────────────────────────────────────────────────┘
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/overlay_bg"
    android:paddingBottom="8dp">

    <!-- Drag handle -->
    <View
        android:id="@+id/drag_handle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#4DFFFFFF"
        android:clickable="true"
        android:focusable="true" />

    <!-- Toolbar row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp">

        <!-- Mic button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageButton
                android:id="@+id/btn_mic"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="#1AFFFFFF"
                android:src="@android:drawable/ic_btn_speak_now"
                android:padding="12dp"
                android:contentDescription="Voice to Text"
                android:scaleType="fitCenter" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Voice"
                android:textColor="#B3FFFFFF"
                android:textSize="10sp"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- Tone button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageButton
                android:id="@+id/btn_tone"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="#1AFFFFFF"
                android:src="@android:drawable/ic_menu_edit"
                android:padding="12dp"
                android:contentDescription="Tone and Rewrite"
                android:scaleType="fitCenter" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tone"
                android:textColor="#B3FFFFFF"
                android:textSize="10sp"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- Icebreaker button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageButton
                android:id="@+id/btn_icebreaker"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="#1AFFFFFF"
                android:src="@android:drawable/star_on"
                android:padding="12dp"
                android:contentDescription="Icebreaker Suggestions"
                android:scaleType="fitCenter" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Icebreaker"
                android:textColor="#B3FFFFFF"
                android:textSize="10sp"
                android:layout_marginTop="3dp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
