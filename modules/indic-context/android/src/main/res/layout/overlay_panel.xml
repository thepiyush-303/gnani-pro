<?xml version="1.0" encoding="utf-8"?>
<!--
  overlay_panel.xml — Assistant Overlay (Dark Glassmorphism Edition)
  Features:
    1. disk_container — 42x42dp Dark Glass circular ring (draggable + edge snapping)
    2. toolbar_container — Dark Glass compact toolbar with dynamic edge reversal (< on right, > on left)
    3. Glide menus (language on 🎙️, voice on 🗣️) are separate overlay windows — see GlideMenu.kt
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:clickable="false"
    android:focusable="false">

    <!-- ── Component 1: The Collapsed Disk (42x42dp Dark Glass) ── -->
    <FrameLayout
        android:id="@+id/disk_container"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="bottom|start"
        android:background="@drawable/bg_ring_pill"
        android:clickable="true"
        android:focusable="true"
        android:elevation="10dp">

        <TextView
            android:id="@+id/disk_spark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clickable="false"
            android:focusable="false"
            android:text="✨"
            android:textColor="#FAFAFA"
            android:textSize="18sp" />

    </FrameLayout>

    <!-- ── Component 2: The Expanded Toolbar (Dark Glass) ── -->
    <LinearLayout
        android:id="@+id/toolbar_container"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="bottom|start"
        android:background="@drawable/overlay_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:elevation="12dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <!-- ── Action Buttons Container (✨, 🗣️, 💬, 🎙️) ── -->
        <LinearLayout
            android:id="@+id/action_buttons_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp">

            <!-- 1. ✨ Sparkle (Improve Text) -->
            <FrameLayout
                android:id="@+id/btn_improve"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_bg_glass"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="✨"
                    android:textColor="#FAFAFA"
                    android:textSize="17sp" />
            </FrameLayout>

            <!-- 2. 🗣️ Voice Changer — tap: record/stop · hold + glide: pick voice -->
            <FrameLayout
                android:id="@+id/btn_voice_changer"
                android:layout_width="42dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_bg_glass"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Voice changer">
                <TextView
                    android:id="@+id/voice_changer_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🗣️"
                    android:textColor="#FAFAFA"
                    android:textSize="16sp" />
                <!-- Selected voice badge (e.g. LAK) -->
                <TextView
                    android:id="@+id/txt_voice_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginBottom="1dp"
                    android:layout_marginEnd="1dp"
                    android:background="@drawable/badge_lang_bg"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:text="DEV"
                    android:textColor="#F0ABFC"
                    android:textSize="7sp"
                    android:textStyle="bold" />
                <!-- Recording state: pulsing dot + timer (button expands into a red pill) -->
                <LinearLayout
                    android:id="@+id/voice_rec_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <View
                        android:id="@+id/voice_rec_dot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/rec_dot" />
                    <TextView
                        android:id="@+id/voice_rec_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFeatureSettings="tnum" />
                </LinearLayout>
            </FrameLayout>

            <!-- 3. 💬 Smart Replies -->
            <FrameLayout
                android:id="@+id/btn_smart_replies"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_bg_glass"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Smart Replies">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="💬"
                    android:textColor="#FAFAFA"
                    android:textSize="16sp" />
            </FrameLayout>

            <!-- 4. 🎙️ Microphone (Voice Dictation + Glide Menu) -->
            <FrameLayout
                android:id="@+id/btn_mic"
                android:layout_width="42dp"
                android:layout_height="38dp"
                android:background="@drawable/btn_bg_glass"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/mic_icon_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🎙️"
                    android:textColor="#FAFAFA"
                    android:textSize="17sp" />

                <!-- Language Badge (Soft Neon Cyan) -->
                <TextView
                    android:id="@+id/txt_lang_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginBottom="1dp"
                    android:layout_marginEnd="1dp"
                    android:background="@drawable/badge_lang_bg"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:text="EN"
                    android:textColor="#00E5FF"
                    android:textSize="7sp"
                    android:textStyle="bold" />
            </FrameLayout>

        </LinearLayout>

        <!-- Vertical Divider -->
        <View
            android:id="@+id/toolbar_divider"
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:background="#26FFFFFF"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp" />

        <!-- ── Collapse Button Handle (< on right, > on left) ── -->
        <FrameLayout
            android:id="@+id/btn_collapse_handle"
            android:layout_width="34dp"
            android:layout_height="match_parent"
            android:background="@drawable/btn_collapse_bg_right"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/collapse_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="‹"
                android:textColor="#FAFAFA"
                android:textSize="20sp"
                android:textStyle="bold" />

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
