<?xml version="1.0" encoding="utf-8"?>
<!--
  overlay_panel.xml — Assistant overlay (dark glass; shown only inside a WhatsApp chat room)
    1. disk_container    — 48dp bubble with the app mark, docked to the screen edge (drag / tap to open)
    2. toolbar_container — 52dp bar: ✨ improve · 🌐 translate · 🗣 voice changer · 💬 smart replies · 🎙 dictation | collapse
  Glide menus (language on mic, voice on voice changer) are separate overlay windows — see GlideMenu.kt.
  Icons are Material Symbols vectors (res/drawable/ic_*.xml), tinted per action.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:clickable="false"
    android:focusable="false">

    <!-- ── 1. Collapsed bubble ── -->
    <FrameLayout
        android:id="@+id/disk_container"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|start"
        android:background="@drawable/bg_ring_pill"
        android:clickable="true"
        android:focusable="true"
        android:elevation="8dp"
        android:contentDescription="Open ConvoAI">

        <ImageView
            android:id="@+id/disk_icon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_convo_mascot"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- ── 2. Expanded toolbar ── -->
    <LinearLayout
        android:id="@+id/toolbar_container"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_gravity="bottom|start"
        android:background="@drawable/overlay_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:elevation="10dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/action_buttons_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- ✨ Improve text -->
            <FrameLayout
                android:id="@+id/btn_improve"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_bg_toolbar"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Improve text">
                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_improve"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <!-- 🌐 Translate — tap: translate the message box text · hold + glide: target language -->
            <FrameLayout
                android:id="@+id/btn_translate"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_bg_toolbar"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Translate">
                <ImageView
                    android:id="@+id/translate_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_translate"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/txt_translate_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/badge_lang_bg"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:text="EN"
                    android:textColor="#FECDD3"
                    android:textSize="7sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- 🗣 Voice changer — tap: record/stop · hold + glide: pick voice -->
            <FrameLayout
                android:id="@+id/btn_voice_changer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_bg_toolbar"
                android:clickable="true"
                android:focusable="true"
                android:clipChildren="false"
                android:contentDescription="Voice changer">
                <ImageView
                    android:id="@+id/voice_changer_icon"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_voice_changer"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/txt_voice_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginBottom="0dp"
                    android:layout_marginEnd="0dp"
                    android:background="@drawable/badge_lang_bg"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:text="DEV"
                    android:textColor="#FECDD3"
                    android:textSize="7sp"
                    android:textStyle="bold" />
                <!-- Recording: button widens into a red pill with pulsing dot + m:ss -->
                <LinearLayout
                    android:id="@+id/voice_rec_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <View
                        android:id="@+id/voice_rec_dot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/rec_dot" />
                    <TextView
                        android:id="@+id/voice_rec_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFeatureSettings="tnum" />
                </LinearLayout>
            </FrameLayout>

            <!-- 💬 Smart replies -->
            <FrameLayout
                android:id="@+id/btn_smart_replies"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_bg_toolbar"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Smart replies">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_smart_replies"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <!-- 🎙 Dictation — tap: dictate · hold + glide: language -->
            <FrameLayout
                android:id="@+id/btn_mic"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/btn_bg_toolbar"
                android:clickable="true"
                android:focusable="true"
                android:clipChildren="false"
                android:contentDescription="Dictation">
                <ImageView
                    android:id="@+id/mic_icon"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_mic"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/txt_lang_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginBottom="0dp"
                    android:layout_marginEnd="0dp"
                    android:background="@drawable/badge_lang_bg"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:text="EN"
                    android:textColor="#FECDD3"
                    android:textSize="7sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <View
            android:id="@+id/toolbar_divider"
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:background="#26FFFFFF" />

        <!-- Collapse (chevron flips with the docked edge) -->
        <FrameLayout
            android:id="@+id/btn_collapse_handle"
            android:layout_width="32dp"
            android:layout_height="40dp"
            android:background="@drawable/btn_bg_toolbar"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Close toolbar">
            <ImageView
                android:id="@+id/collapse_arrow"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_chevron_left"
                android:importantForAccessibility="no" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
