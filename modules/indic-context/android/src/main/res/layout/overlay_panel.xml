<?xml version="1.0" encoding="utf-8"?>
<!--
  overlay_panel.xml — Assistant Overlay (Dark Glassmorphism Edition)
  Features:
    1. disk_container — 42x42dp Dark Glass circular ring (draggable + edge snapping)
    2. toolbar_container — Dark Glass compact toolbar with dynamic edge reversal (< on right, > on left)
    3. language_popup_wrapper — Floating language list + Caret pointing to Mic icon (zIndex/elevation above toolbar)
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:clickable="false"
    android:focusable="false">

    <!-- ── Component 1: The Collapsed Disk (42x42dp Dark Glass) ── -->
    <FrameLayout
        android:id="@+id/disk_container"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="bottom|start"
        android:background="@drawable/bg_ring_pill"
        android:clickable="true"
        android:focusable="true"
        android:elevation="10dp">

        <TextView
            android:id="@+id/disk_spark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clickable="false"
            android:focusable="false"
            android:text="✨"
            android:textColor="#FAFAFA"
            android:textSize="18sp" />

    </FrameLayout>

    <!-- ── Component 2: The Expanded Toolbar (Dark Glass) ── -->
    <LinearLayout
        android:id="@+id/toolbar_container"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="bottom|start"
        android:background="@drawable/overlay_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:elevation="12dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <!-- ── Action Buttons Container (✨, 🔍, 🧊, 🎙️) ── -->
        <LinearLayout
            android:id="@+id/action_buttons_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp">

            <!-- 1. ✨ Sparkle (Improve Text) -->
            <FrameLayout
                android:id="@+id/btn_improve"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_bg_glass"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="✨"
                    android:textColor="#FAFAFA"
                    android:textSize="17sp" />
            </FrameLayout>

            <!-- 2. 🔍 Fact Check -->
            <FrameLayout
                android:id="@+id/btn_factcheck"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_bg_glass"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🔍"
                    android:textColor="#FAFAFA"
                    android:textSize="16sp" />
            </FrameLayout>

            <!-- 3. 🧊 Icebreaker -->
            <FrameLayout
                android:id="@+id/btn_icebreaker"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_bg_glass"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🧊"
                    android:textColor="#FAFAFA"
                    android:textSize="16sp" />
            </FrameLayout>

            <!-- 4. 🎙️ Microphone (Voice Dictation + Glide Menu) -->
            <FrameLayout
                android:id="@+id/btn_mic"
                android:layout_width="42dp"
                android:layout_height="38dp"
                android:background="@drawable/btn_bg_glass"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/mic_icon_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🎙️"
                    android:textColor="#FAFAFA"
                    android:textSize="17sp" />

                <!-- Language Badge (Soft Neon Cyan) -->
                <TextView
                    android:id="@+id/txt_lang_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginBottom="1dp"
                    android:layout_marginEnd="1dp"
                    android:background="@drawable/badge_lang_bg"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:text="EN"
                    android:textColor="#00E5FF"
                    android:textSize="7sp"
                    android:textStyle="bold" />
            </FrameLayout>

        </LinearLayout>

        <!-- Vertical Divider -->
        <View
            android:id="@+id/toolbar_divider"
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:background="#26FFFFFF"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp" />

        <!-- ── Collapse Button Handle (< on right, > on left) ── -->
        <FrameLayout
            android:id="@+id/btn_collapse_handle"
            android:layout_width="34dp"
            android:layout_height="match_parent"
            android:background="@drawable/btn_collapse_bg_right"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/collapse_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="‹"
                android:textColor="#FAFAFA"
                android:textSize="20sp"
                android:textStyle="bold" />

        </FrameLayout>

    </LinearLayout>

    <!-- ── Component 3: Glide-Select Language Menu Popup with Caret ── -->
    <!-- Declared AFTER toolbar in FrameLayout + elevation 32dp for strict top Z-Index -->
    <LinearLayout
        android:id="@+id/language_popup_wrapper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="56dp"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="32dp"
        android:translationZ="10dp"
        android:visibility="gone">

        <!-- Main Language Card -->
        <LinearLayout
            android:id="@+id/language_menu_card"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:background="@drawable/language_menu_bg"
            android:orientation="vertical"
            android:padding="8dp"
            android:elevation="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Glide finger to select"
                android:textColor="#00E5FF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="6dp" />

            <!-- 1. English -->
            <TextView
                android:id="@+id/lang_item_en"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/language_pill_bg"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="English (EN)"
                android:textColor="#FAFAFA"
                android:textSize="12sp"
                android:tag="en-IN:EN" />

            <!-- 2. Hindi -->
            <TextView
                android:id="@+id/lang_item_hi"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/language_pill_bg"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Hindi (हिन्दी - HI)"
                android:textColor="#FAFAFA"
                android:textSize="12sp"
                android:tag="hi-IN:HI" />

            <!-- 3. Marathi -->
            <TextView
                android:id="@+id/lang_item_mr"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/language_pill_bg"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Marathi (मराठी - MR)"
                android:textColor="#FAFAFA"
                android:textSize="12sp"
                android:tag="mr-IN:MR" />

            <!-- 4. Bangla -->
            <TextView
                android:id="@+id/lang_item_bn"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/language_pill_bg"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Bangla (বাংলা - BN)"
                android:textColor="#FAFAFA"
                android:textSize="12sp"
                android:tag="bn-IN:BN" />

            <!-- 5. Telugu -->
            <TextView
                android:id="@+id/lang_item_te"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/language_pill_bg"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Telugu (తెలుగు - TE)"
                android:textColor="#FAFAFA"
                android:textSize="12sp"
                android:tag="te-IN:TE" />

            <!-- 6. Tamil -->
            <TextView
                android:id="@+id/lang_item_ta"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/language_pill_bg"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Tamil (தமிழ் - TA)"
                android:textColor="#FAFAFA"
                android:textSize="12sp"
                android:tag="ta-IN:TA" />

            <!-- 7. Malayalam -->
            <TextView
                android:id="@+id/lang_item_ml"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:background="@drawable/language_pill_bg"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Malayalam (മലയാളം - ML)"
                android:textColor="#FAFAFA"
                android:textSize="12sp"
                android:tag="ml-IN:ML" />

        </LinearLayout>

        <!-- Downward Caret (Vector Triangle) pointing directly at Mic icon below -->
        <ImageView
            android:id="@+id/menu_caret"
            android:layout_width="14dp"
            android:layout_height="8dp"
            android:layout_gravity="start"
            android:src="@drawable/ic_caret_down"
            android:elevation="33dp"
            android:translationZ="12dp" />

    </LinearLayout>

</FrameLayout>
