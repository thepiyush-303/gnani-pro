<?xml version="1.0" encoding="utf-8"?>
<!--
  overlay_panel.xml — Phase 2 copilot toolbar

  Full-width floating card with:
  ┌────────────────────────────────────────────────────┐
  │   ▬▬  drag handle             [12 ctx]  [✕]       │
  │  🎤      🎨      ✅      ❄️                        │
  │ Voice   Tone   Fact    Ice                         │
  └────────────────────────────────────────────────────┘

  The FrameLayout root is transparent and NOT clickable,
  so touches outside the card pass through to WhatsApp/Telegram.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="false"
    android:focusable="false">

    <!-- Floating card with horizontal margins -->
    <LinearLayout
        android:id="@+id/overlay_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="6dp"
        android:orientation="vertical"
        android:background="@drawable/overlay_bg"
        android:elevation="10dp">

        <!-- ── Row 1: drag handle + context badge + close ── -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <!-- Drag handle centred -->
            <View
                android:id="@+id/drag_handle"
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_centerInParent="true"
                android:background="@drawable/drag_handle_bg"
                android:clickable="true"
                android:focusable="true" />

            <!-- Context message count badge -->
            <TextView
                android:id="@+id/context_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/btn_close"
                android:layout_centerVertical="true"
                android:layout_marginEnd="4dp"
                android:background="@drawable/badge_bg"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone"
                android:text="0" />

            <!-- Close button -->
            <ImageButton
                android:id="@+id/btn_close"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="Close copilot"
                android:padding="5dp"
                android:scaleType="fitCenter" />
        </RelativeLayout>

        <!-- ── Row 2: Feature action buttons ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="10dp">

            <!-- Mic / Voice -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageButton
                    android:id="@+id/btn_mic"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/btn_bg_mic"
                    android:src="@android:drawable/ic_btn_speak_now"
                    android:padding="11dp"
                    android:contentDescription="Voice to Text"
                    android:scaleType="fitCenter" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Voice"
                    android:textColor="#64748B"
                    android:textSize="9sp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <!-- Tone rewrite -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageButton
                    android:id="@+id/btn_tone"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/btn_bg_tone"
                    android:src="@android:drawable/ic_menu_edit"
                    android:padding="11dp"
                    android:contentDescription="Tone Rewrite"
                    android:scaleType="fitCenter" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tone"
                    android:textColor="#64748B"
                    android:textSize="9sp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <!-- Fact check -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageButton
                    android:id="@+id/btn_factcheck"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/btn_bg_factcheck"
                    android:src="@android:drawable/ic_menu_info_details"
                    android:padding="11dp"
                    android:contentDescription="Fact Check"
                    android:scaleType="fitCenter" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fact"
                    android:textColor="#64748B"
                    android:textSize="9sp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <!-- Icebreaker -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageButton
                    android:id="@+id/btn_icebreaker"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/btn_bg_ice"
                    android:src="@android:drawable/star_on"
                    android:padding="11dp"
                    android:contentDescription="Icebreaker"
                    android:scaleType="fitCenter" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ice"
                    android:textColor="#64748B"
                    android:textSize="9sp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</FrameLayout>
