<?xml version="1.0" encoding="utf-8"?>
<!--
  edge_pill.xml
  Root FrameLayout wraps two children:
    1. edge_tab_container  - visible by default (collapsed pill docked to right edge)
    2. edge_toolbar_container - GONE by default, shown when user taps the pill
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clickable="false"
    android:focusable="false">

    <!-- ── Collapsed pill (tab shown on right edge) ── -->
    <LinearLayout
        android:id="@+id/edge_tab_container"
        android:layout_width="36dp"
        android:layout_height="64dp"
        android:layout_gravity="top|end"
        android:alpha="0.72"
        android:background="#806366F1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/edge_tab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:text="AI"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ── Expanded toolbar (shown when pill is tapped) ── -->
    <LinearLayout
        android:id="@+id/edge_toolbar_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:background="@drawable/overlay_bg"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <!-- Close button row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/edge_toolbar_close"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="X"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Context badge -->
        <TextView
            android:id="@+id/context_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="6dp"
            android:background="@drawable/badge_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="0"
            android:textColor="#F8FAFC"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Action buttons (vertical in edge mode) -->
        <LinearLayout
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Mic -->
            <TextView
                android:id="@+id/edge_btn_mic"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/btn_bg_mic"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="MIC"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <!-- Tone -->
            <TextView
                android:id="@+id/edge_btn_tone"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/btn_bg_tone"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="TONE"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <!-- Fact Check -->
            <TextView
                android:id="@+id/edge_btn_factcheck"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/btn_bg_factcheck"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="FACT"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <!-- Icebreaker -->
            <TextView
                android:id="@+id/edge_btn_icebreaker"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/btn_bg_ice"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="ICE"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>

