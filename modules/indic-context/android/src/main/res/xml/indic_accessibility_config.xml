<?xml version="1.0" encoding="utf-8"?>
<!--
  Accessibility Service configuration for ChatAccessibilityService.

  - accessibilityEventTypes: We listen for content changes and scroll events
    to capture newly visible chat bubbles, plus focus events to track input fields.
  - canRetrieveWindowContent: REQUIRED to walk the node tree and read TextView text.
  - notificationTimeout: 100ms — fast enough to capture messages as they appear.
  - packageNames: Restricts the service to only these apps (performance + privacy).

  This file is copied into android/app/src/main/res/xml/ by the config plugin
  during `npx expo prebuild`.
-->
<accessibility-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowContentChanged|typeViewScrolled|typeViewFocused"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:packageNames="com.whatsapp,com.whatsapp.w4b,org.telegram.messenger,org.telegram.messenger.web"
    android:settingsActivity=".MainActivity" />
