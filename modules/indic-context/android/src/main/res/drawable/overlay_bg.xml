<?xml version="1.0" encoding="utf-8"?>
<!-- overlay_bg.xml - Expanded toolbar: dark glass bar, 26dp radius, hairline border.
     Stays dark in both system themes because it floats over WhatsApp. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F0121726" />
    <corners android:radius="26dp" />
    <stroke android:width="1dp" android:color="#2EFFFFFF" />
</shape>
