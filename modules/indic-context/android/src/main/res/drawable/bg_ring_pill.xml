<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <!-- Gradient ring background -->
    <gradient
        android:angle="135"
        android:startColor="#6366F1"
        android:endColor="#4338CA"
        android:type="linear" />
    <!-- Crisp ring border -->
    <stroke
        android:width="2.5dp"
        android:color="#FFFFFF" />
    <size
        android:width="56dp"
        android:height="56dp" />
</shape>