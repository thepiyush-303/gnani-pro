<?xml version="1.0" encoding="utf-8"?>
<!-- bg_ring_pill.xml - Collapsed 42x42dp disk with vibrant Indigo-to-Purple frosted gradient -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:angle="135"
        android:startColor="#6366F1"
        android:endColor="#8B5CF6"
        android:type="linear" />
    <stroke
        android:width="2dp"
        android:color="#B4C6FC" />
    <size
        android:width="42dp"
        android:height="42dp" />
</shape>
